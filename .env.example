# MongoDB Connection String
# Copy this file to .env and fill in your credentials
# .env file is ignored by git and will not be committed

# MongoDB Atlas Connection String
# Format: mongodb+srv://<username>:<password>@cluster0.h7mvlta.mongodb.net/?appName=Cluster0
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.h7mvlta.mongodb.net/?appName=Cluster0

# Database name (default: trading_journal)
# MONGODB_DATABASE=trading_journal

# For local MongoDB, use:
# MONGODB_URI=mongodb://localhost:27017/
